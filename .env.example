# PostgreSQL
# Use either one connection string or the split LOCAL_DB_* values below.
# For Vercel, set this to your externally reachable server PostgreSQL URL.
LOCAL_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# POSTGRES_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
LOCAL_DB_SSL=false
PG_POOL_MAX=5

# Auth/session signing. Generate a long random value for production.
LOCAL_AUTH_SECRET=replace-with-a-long-random-secret

# Admin/API protection. Required for admin Odoo sync endpoints.
ADMIN_API_KEY=replace-with-a-long-random-api-key

# Public site settings
NEXT_PUBLIC_SITE_URL=https://your-vercel-domain.vercel.app
NEXT_PUBLIC_SITE_NAME=iroselectronics
NEXT_PUBLIC_SITE_DOMAIN=iroselectronics.com
NEXT_PUBLIC_DEFAULT_LOCALE=es

# Odoo inventory sync. Required only for sync scripts/admin sync endpoints.
ODOO_BASE_URL=https://your-odoo-domain.com
ODOO_DATABASE=your-odoo-database
ODOO_USERNAME=you@example.com
# ODOO_LOGIN=you@example.com
# Prefer API key when available.
ODOO_API_KEY=replace-with-odoo-api-key
# ODOO_PASSWORD=replace-with-odoo-password
ODOO_SYNC_LIMIT=200

# Stripe checkout. Required only if Stripe checkout is enabled.
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_replace_me

# Optional AI/image tooling used by local scripts/admin tools.
AZURE_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-image-2
OPENAI_API_VERSION=2025-04-01-preview
